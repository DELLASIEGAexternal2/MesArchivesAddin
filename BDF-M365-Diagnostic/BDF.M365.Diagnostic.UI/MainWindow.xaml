<Window x:Class="BDF.M365.Diagnostic.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BDF M365 Diagnostic"
        Height="700"
        Width="1200">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="10">
            <Button Name="BtnManifest"
                    Width="200"
                    Height="40"
                    Click="BtnManifest_Click">
                Analyser Manifest
            </Button>

            <Button Name="BtnGithub"
                    Width="200"
                    Height="40"
                    Margin="10,0,0,0"
                    Click="BtnGithub_Click">
                Tester GitHub
            </Button>
        </StackPanel>

        <TextBox Name="TxtOutput"
                 Grid.Row="1"
                 Margin="10"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Window>